#==========================================================================
# ARTISORA — PUBLIC .htaccess (Laravel Front Controller)
#==========================================================================
# This is the main .htaccess inside /public. It handles:
# 1. HTTPS enforcement
# 2. Authorization header passthrough
# 3. Trailing slash removal
# 4. Front-controller routing (all requests → index.php)
# 5. Security headers
# 6. GZIP compression for performance
# 7. Browser caching for static assets
#==========================================================================

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        #------------------------------------------------------------------
        # Disable MultiViews to prevent Apache from guessing file names
        # Disable Indexes to prevent directory listing
        #------------------------------------------------------------------
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    #----------------------------------------------------------------------
    # FORCE HTTPS
    #----------------------------------------------------------------------
    # Ensure all traffic uses HTTPS. Hostinger provides free SSL via
    # Let's Encrypt; this rule enforces it at the Apache level.
    #----------------------------------------------------------------------
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    #----------------------------------------------------------------------
    # HANDLE AUTHORIZATION HEADER
    #----------------------------------------------------------------------
    # Pass the Authorization header through to PHP.
    # Required for API token authentication (Sanctum / Bearer tokens).
    # Some shared hosts strip this header by default.
    #----------------------------------------------------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    #----------------------------------------------------------------------
    # HANDLE X-XSRF-TOKEN HEADER
    #----------------------------------------------------------------------
    # Pass the XSRF token header through to PHP.
    # Required for Inertia.js / SPA CSRF protection.
    #----------------------------------------------------------------------
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    #----------------------------------------------------------------------
    # REDIRECT TRAILING SLASHES (if not a directory)
    #----------------------------------------------------------------------
    # Normalizes URLs: /about/ → /about
    # Prevents duplicate content issues for SEO.
    #----------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    #----------------------------------------------------------------------
    # FRONT CONTROLLER — Send All Requests to index.php
    #----------------------------------------------------------------------
    # If the request doesn't match an actual file or directory,
    # route it through Laravel's index.php entry point.
    #----------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

#==========================================================================
# SECURITY HEADERS
#==========================================================================
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header set X-Content-Type-Options "nosniff"

    # XSS protection for older browsers
    Header set X-XSS-Protection "1; mode=block"

    # Prevent clickjacking — only allow same-origin iframes
    Header set X-Frame-Options "SAMEORIGIN"

    # Referrer policy — send full referrer within site, origin only to others
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Strict Transport Security — force HTTPS for 1 year (31536000 seconds)
    # includeSubDomains covers all subdomains of tantuco-ctc.store
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

#==========================================================================
# GZIP COMPRESSION
#==========================================================================
# Compress text-based resources to reduce bandwidth and improve load times.
# This can reduce transfer sizes by 60-80% for HTML, CSS, and JS.
#==========================================================================
<IfModule mod_deflate.c>
    # HTML, XML, CSS, JavaScript
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml

    # JSON & API responses
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json

    # Fonts (WOFF is already compressed; WOFF2 uses Brotli)
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE image/svg+xml

    # Plain text & RSS
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE application/rss+xml
</IfModule>

#==========================================================================
# BROWSER CACHING — Static Assets
#==========================================================================
# Set expiration headers for static files so browsers cache them locally.
# Vite-built assets have hashed filenames, so they can be cached aggressively.
#==========================================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Default: 1 week
    ExpiresDefault "access plus 1 week"

    # HTML — don't cache (always fetch fresh for SPA navigation)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS & JavaScript — cache for 1 year (Vite uses content hashes)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images — cache for 1 month
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts — cache for 1 year
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
</IfModule>
